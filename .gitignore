# the Laravel tree's dependencies — never committed
app/vendor/
app/node_modules/
app/.env
app/storage/framework/cache/
app/storage/framework/sessions/
app/storage/framework/views/
app/storage/logs/
app/public/build/

# evidence is written by the runtime and read by the journey stage.
# it is NOT committed: a proof in git is a proof somebody could have edited.
app/storage/app/evidence/

__pycache__/
*.pyc

# per-track supervisor mailbox — never merged, never shared (owner ruling 2026-09-04)
# the supervisor's mailbox is working-tree only — main ignores it, and a merge that
# writes one track's copies over another's destroys the verdict record.
.agents/supervisor/*
!.agents/supervisor/launch-coder.sh
scratch/

# cPanel writes this on every PHP run; tracking it makes every tree dirty (2026-09-20)
/error_log
