{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=$(command -v python3 || command -v python); \"$PY\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-piped-gate-tool.py\"",
            "timeout": 10,
            "statusMessage": "checking for a piped gate tool"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.agents/supervisor/**)",
      "Write(.agents/supervisor/**)",
      "Edit(.agents/rules/10-supervisor.md)",
      "Write(.agents/rules/10-supervisor.md)",
      "Edit(bin/supervise.sh)",
      "Write(bin/supervise.sh)",
      "Bash(bash bin/supervise.sh:*)",
      "Bash(bin/supervise.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-list:*)",
      "Bash(git fetch --no-write-fetch-head:*)",
      "Bash(python3 bin/state.py next)",
      "Bash(python3 bin/state.py status)",
      "Bash(python3 bin/state.py report)",
      "Bash(php artisan doctor:*)",
      "Bash(php artisan why:*)",
      "Bash(php -l:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(./vendor/bin/pint --test:*)",
      "Bash(bash .agents/supervisor/launch-coder.sh:*)",
      "Bash(git push origin:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Edit(bin/state.py)",
      "Write(bin/state.py)",
      "Edit(//home/goaiez/agents/supervisor-tick.sh)",
      "Edit(//home/goaiez/agents/coder-bin/git)"
    ],
    "deny": [
      "NotebookEdit",
      "Edit(app/**)",
      "Write(app/**)",
      "Edit(source/**)",
      "Write(source/**)",
      "Edit(runtime/**)",
      "Write(runtime/**)",
      "Edit(.agents/state/**)",
      "Write(.agents/state/**)",
      "Edit(.agents/rules/0*.md)",
      "Write(.agents/rules/0*.md)",
      "Edit(.agents/workflows/**)",
      "Write(.agents/workflows/**)",
      "Edit(build-plan.json)",
      "Write(build-plan.json)",
      "Edit(//home/goaiez/public_html/**)",
      "Write(//home/goaiez/public_html/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(php artisan migrate:*)",
      "Bash(php artisan db:*)",
      "Bash(php artisan module:*)",
      "Bash(php artisan app:deploy-check:*)",
      "Bash(python3 bin/state.py decided:*)",
      "Bash(python3 bin/state.py unresolved:*)",
      "Bash(python3 bin/state.py stage:*)",
      "Bash(python3 bin/state.py note:*)",
      "Bash(python3 bin/state.py selftest:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",
      "Bash(createdb:*)",
      "Bash(./vendor/bin/pest:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(php artisan test:*)",
      "Bash(./vendor/bin/pint --repair:*)",
      "Bash(./vendor/bin/pint --dirty:*)",
      "Bash(runtime/goaiez-runtime.sh:*)"
    ]
  }
}
